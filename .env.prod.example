# Postgres
POSTGRES_USER=your_value
POSTGRES_PASSWORD=use-a-strong-password-here
POSTGRES_DB=kraftmeister

# api-gateway
JWT_SECRET=use-a-long-random-secret-min-32-chars
DATABASE_URL=postgresql://your_user:your_password@postgres:5432/kraftmeister
REDIS_URL=redis://redis:6379
AI_SERVICE_URL=http://ai-service:8000
CORS_ORIGIN=https://yourdomain.com
SENTRY_DSN=https://...@sentry.io/...

# frontend
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# ai-service
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# MinIO
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=use-a-strong-password-here
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=kraftmeister-photos
MINIO_PUBLIC_URL=https://yourdomain.com:9000
MINIO_PUBLIC_URL=http://localhost:9000
