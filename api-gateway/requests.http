##############################################################
### Find all jobs
GET http://localhost:4000/jobs?date=2026-05-24
### Find job by ID
GET http://localhost:4000/jobs/cmpj8xdi100001kn8a8qyh3f3

### Create a new job
POST http://localhost:4000/jobs
Content-Type: application/json

{
  "title": "Software Engineer",
  "description": "We are looking for a skilled software engineer to join our team.",
  "status": "ystus"
}

### Update a job
PATCH http://localhost:4000/jobs/cmph7jzv8000001qwn3laltv1
Content-Type: application/json  

{
    "title": "Update job",
    "description": "jfs f skfj sfj s sdfjdsf ds ksfjdslf s fkdsjf",
    "status": "open",
    "address": "jdsjfkdsf"
  }

##############################################################
### Find all customers
GET http://localhost:4000/customers
### Find customer by ID
GET http://localhost:4000/customers/cmpo82h8pfdd00006bpexhp1iqpv

### Create a new customer
POST http://localhost:4000/customers
Content-Type: application/json

{
  "name": "John Smith",
  "email": "john-smith@example.de",
  "phone": "+25 150 849u432",
  "address": "Some street 31, 80331 middle of nowhre"
}

### Update a customer
PATCH http://localhost:4000/customers/cmpo82h8p00006bpexhp1iqpv
Content-Type: application/json

{
  "name": "Updated Adam Sandler",
  "email": "adem-senadler@example.de"
}

### Delete a customer
DELETE http://localhost:4000/customers/cmpo6nuhi000037peb0864odc

### Search customers
GET http://localhost:4000/customers?search=Hans

##############################################################
### Register (creates company + admin user, returns tokens)
POST http://localhost:4000/auth/register
Content-Type: application/json

{
  "companyName": "Muster GmbH",
  "email": "admin2@muster.de",
  "password": "password123"
}

###

### Login
POST http://localhost:4000/auth/login
Content-Type: application/json

{
  "email": "admin@muster.de",
  "password": "demo1234"
}

###

### Refresh tokens (paste refreshToken from login/register response)
POST http://localhost:4000/auth/refresh
Content-Type: application/json

{
  "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJjbXBzZjlqb24wMDAzMm1wbnFmanR2NDZsIiwiY29tcGFueUlkIjoiY21wc2Y5am5tMDAwMjJtcG5lcG5sZmFnOSIsInJvbGUiOiJBRE1JTiIsImlhdCI6MTc4MDE0OTg2MSwiZXhwIjoxNzgwNzU0NjYxfQ.NrYV5N22eJ3PdNOQbm0-6-hd9LBwmjwGntsWZLayKvg"
}

###

### Get current user profile (requires accessToken in Authorization header)
GET http://localhost:4000/auth/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJjbXByNnI0bGYwMDAxNDFwZTFrbnp0cmtlIiwiY29tcGFueUlkIjoiY21wcjZyNGZmMDAwMDQxcGU0NWd6d3ZxdyIsInJvbGUiOiJBRE1JTiIsImlhdCI6MTc4MDgyMzY3MywiZXhwIjoxNzgwODI0NTczfQ.QPgUVwMVPYVaL4ovRxxjr9Vd-9XdXwlCZO8OtjocQk4

###

### Logout (requires accessToken in Authorization header)
POST http://localhost:4000/auth/logout
Authorization: Bearer PASTE_ACCESS_TOKEN_HERE

### Get all users
GET http://localhost:4000/users

### Get user by ID
GET http://localhost:4000/users/PASTE_USER_ID_HERE

### Create user (password must be pre-hashed by caller — use auth/register instead for real signups)
POST http://localhost:4000/users
Content-Type: application/json

{
  "companyId": "PASTE_COMPANY_ID_HERE",
  "email": "worker@muster.de",
  "password": "password123",
  "role": "WORKER"
}

### Update user
PATCH http://localhost:4000/users/PASTE_USER_ID_HERE
Content-Type: application/json

{
  "email": "newemail@muster.de",
  "role": "WORKER"
}

### Delete user
DELETE http://localhost:4000/users/PASTE_USER_ID_HERE

##############################################################
### AI — Suggest invoice line items from a job description
POST http://localhost:4000/ai/suggest-items
Content-Type: application/json

{
  "jobDescription": "Badezimmer renovieren, Fliesen verlegen, Sanitär erneuern",
  "jobType": "Sanitär"
}

###

### AI — Analyze a job site photo by URL
POST http://localhost:4000/ai/analyze-photo
Content-Type: application/json

{
  "imageUrl": "https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/PNG_transparency_demonstration_1.png/280px-PNG_transparency_demonstration_1.png"
}

###

### AI — Voice to job (multipart/form-data — use a REST client that supports file upload)
# POST http://localhost:4000/ai/voice-to-job
# Content-Type: multipart/form-data
# audio: <path-to-audio-file.mp3>

### Test Sentry
GET http://localhost:4000/auth/debug-sentry

