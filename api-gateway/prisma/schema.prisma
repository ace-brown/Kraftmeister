generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum JobStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Role {
  ADMIN
  WORKER
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  address   String?
  vatId     String?
  createdAt DateTime @default(now())
  users     User[]
  customers Customer[]
  jobs      Job[]
  quotes    Quote[]
  invoices  Invoice[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id])
  @@index([companyId])
}

model Customer {
  id        String    @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  company  Company   @relation(fields: [companyId], references: [id])
  jobs     Job[]
  quotes   Quote[]
  invoices Invoice[]
  @@index([companyId])
}

model Job {
  id          String    @id @default(cuid())
  companyId   String
  customerId  String?
  title       String
  description String?
  status      JobStatus @default(OPEN)
  address     String?
  photos      String[]
  createdAt   DateTime  @default(now())
  company  Company   @relation(fields: [companyId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  quotes   Quote[]
  @@index([companyId])
}

model Quote {
  id         String      @id @default(cuid())
  companyId  String
  customerId String
  jobId      String?
  status     QuoteStatus @default(DRAFT)
  vatRate    Float       @default(19)
  total      Float       @default(0)
  createdAt  DateTime    @default(now())
  company  Company    @relation(fields: [companyId], references: [id])
  customer Customer   @relation(fields: [customerId], references: [id])
  job      Job?       @relation(fields: [jobId], references: [id])
  items    QuoteItem[]
  invoice  Invoice?
  @@index([companyId])
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  description String
  quantity    Float
  unitPrice   Float
  quote Quote @relation(fields: [quoteId], references: [id])
}

model Invoice {
  id            String        @id @default(cuid())
  companyId     String
  customerId    String
  quoteId       String?       @unique
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  createdAt     DateTime      @default(now())
  company  Company       @relation(fields: [companyId], references: [id])
  customer Customer      @relation(fields: [customerId], references: [id])
  quote    Quote?        @relation(fields: [quoteId], references: [id])
  items    InvoiceItem[]
  @@index([companyId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float
  unitPrice   Float
  vatRate     Float   @default(19)
  invoice Invoice @relation(fields: [invoiceId], references: [id])
}
