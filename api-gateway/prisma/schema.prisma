generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}


model Job {
  id          String   @id @default(cuid())
  title       String
  description String?
  status  JobStatus  @default(OPEN)
  address     String?
  createdAt   DateTime @default(now())
}
